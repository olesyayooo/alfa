# Local development only. Set real server values outside Git.
POSTGRES_USER=alfa
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=alfa_course
POSTGRES_PORT=5437
DATABASE_URL=postgresql://alfa:replace_me@localhost:5437/alfa_course

# In Docker use a persistent mounted directory, for example /var/cache/alfa-models.
SEMANTIC_MODEL_CACHE=.model-cache
SEMANTIC_DEVICE=cpu
SEMANTIC_OFFLINE=0
HF_HUB_OFFLINE=0
OMP_NUM_THREADS=2
